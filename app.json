{
  "name": "linprinter",
  "category": "app",
  "description": "Document printer for Linux (driverless IPP over USB, CUPS, Print to PDF)",
  "installer": "install.sh",
  "run_as": "user",
  "offline": {
    "apt": [
      "python3",
      "python3-gi",
      "python3-gi-cairo",
      "gir1.2-gtk-3.0",
      "python3-pil",
      "cups",
      "cups-client",
      "cups-filters",
      "cups-ipp-utils",
      "ipp-usb",
      "ghostscript",
      "fontconfig",
      "fonts-dejavu-core",
      "librsvg2-common"
    ]
  }
}
